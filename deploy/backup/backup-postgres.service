# Backup diário de db_auth e db_dashboard. Disparado por backup-postgres.timer.
# Roda como "postgres" (acesso peer local, sem senha). Para outro host/usuário
# (ex.: db_auth em nuvem), crie /etc/dashboard/backup-postgres.env (chmod 600) com
# PGHOST_DB_AUTH/PGUSER_DB_AUTH/PGPASSWORD ou use ~postgres/.pgpass — o "-" abaixo
# ignora o arquivo se ele não existir.
[Unit]
Description=Backup diário do PostgreSQL (db_auth, db_dashboard)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/dashboard/backup-postgres.env
ExecStart=/opt/dashboard/deploy/backup/backup-postgres.sh
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/dashboard
