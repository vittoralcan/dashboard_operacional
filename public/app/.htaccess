# Painel Operacional (Noir Bento) — cabeçalhos, CSP e cache de /app/ (frontend_spec.md §10–11, §13).
#
# CSP em MODO RELATÓRIO (Onda 9): o navegador só AVISA (console + chave `dsn-csp` do sessionStorage, ver
# js/csp-relato.js); nada é bloqueado. Depois de uma rodada limpa em homologação (/_hml/), troque o nome do
# cabeçalho de `Content-Security-Policy-Report-Only` para `Content-Security-Policy` (Onda 10, "enforce").
# O teste E2E (tests/e2e) lê a política DAQUI e a aplica em modo bloqueio — qualquer violação reprova o CI.
#
# Fonte única das origens permitidas: as três bases de API de js/config.js + o Apps Script do Monitoramento
# (sai quando o recurso `monitor.nativo` assumir). Ao mudar `API` ou GAS_MONITOR, mude `connect-src` aqui
# (tests/app/htaccess.test.js confere).

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://auth.example.com https://painel.example.com https://script.google.com https://script.googleusercontent.com; media-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Sem bundler não há hash no nome do arquivo: HTML/JS/CSS/JSON/sprite sempre revalidam (ETag → 304).
  <FilesMatch "\.(html|js|mjs|css|json|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Bibliotecas de terceiros têm a VERSÃO NO NOME (xlsx-0.20.3…, html5-qrcode-2.3.8…): imutáveis por 1 ano.
  <FilesMatch "^(xlsx|html5-qrcode)-[0-9.]+.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fontes não têm versão no nome: 30 dias (trocar a fonte = trocar o nome do arquivo e o preload).
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
