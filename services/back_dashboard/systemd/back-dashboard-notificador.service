# Notificador (RN-013): gargalo, ETL atrasado e meta atingida. Disparado pelo
# timer de mesmo nome a cada 5 min.
#
# Instalação (na VM, depois de back-dashboard.service já existir):
#   sudo cp back-dashboard-notificador.service back-dashboard-notificador.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now back-dashboard-notificador.timer
#
# Operação:
#   systemctl list-timers back-dashboard-notificador.timer
#   journalctl -u back-dashboard-notificador -n 50
#   sudo systemctl start back-dashboard-notificador      roda um ciclo agora

[Unit]
Description=Notificador de gargalo/ETL atrasado/meta atingida (back_dashboard)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=dashboard
Group=dashboard
EnvironmentFile=/etc/dashboard/back-dashboard.env
WorkingDirectory=/opt/dashboard/services/back_dashboard
ExecStart=/usr/bin/node jobs/notificador.js
TimeoutStartSec=5min
MemoryMax=256M
Nice=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
