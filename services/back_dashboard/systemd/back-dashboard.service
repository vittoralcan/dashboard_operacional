# API única do painel (todos os projetos, exceto autenticação — que segue em back-auth.service).
#
# Instalação (uma vez, na VM):
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin dashboard
#   sudo install -d -m 755 /etc/dashboard
#   sudo install -m 600 -o root .env /etc/dashboard/back-dashboard.env
#   sudo cp back-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now back-dashboard
#
# Operação: journalctl -u back-dashboard -f

[Unit]
Description=back-dashboard (API única do painel)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=dashboard
Group=dashboard
EnvironmentFile=/etc/dashboard/back-dashboard.env
# BE-03 (docs/arquitetura/seguranca.md): sem isso, o Express roda em modo
# "development" — o handler de erro padrão (antes do nosso, em app.js)
# incluiria stack trace e caminhos absolutos na resposta de qualquer erro
# não tratado.
Environment=NODE_ENV=production
# Ajustar se o clone do repositório ou o Node (which node) estiverem em outro caminho.
WorkingDirectory=/opt/dashboard/services/back_dashboard
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
# Teto de memória para que esta API (e seus relatórios) nunca sufoquem o back-auth na mesma VM.
MemoryMax=768M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
