# Dispara back-dashboard-monitor.service a cada 5 minutos. O job em si decide
# se roda de verdade (compara painel.monitor_config.intervalo_min contra a
# última verificação) — o timer não precisa mudar quando o intervalo mudar
# pela tela (PUT /api/monitoramento/intervalo).

[Unit]
Description=Agenda o verificador de APIs monitoradas a cada 5 minutos

[Timer]
OnCalendar=*:0/5
AccuracySec=5s

[Install]
WantedBy=timers.target
