# Retenção diária de painel.* (notificacao > 30d, auditoria > 180d,
# monitor_verificacao > 30d, envio_caixa > 180d). Disparado pelo timer de
# mesmo nome, uma vez por dia às 03:00.
#
# Instalação (na VM, depois de back-dashboard.service já existir):
#   sudo cp back-dashboard-retencao.service back-dashboard-retencao.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now back-dashboard-retencao.timer
#
# Operação:
#   systemctl list-timers back-dashboard-retencao.timer
#   journalctl -u back-dashboard-retencao -n 50
#   sudo systemctl start back-dashboard-retencao      roda agora

[Unit]
Description=Retenção diária de dados de apoio do painel (back_dashboard)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=dashboard
Group=dashboard
EnvironmentFile=/etc/dashboard/back-dashboard.env
WorkingDirectory=/opt/dashboard/services/back_dashboard
ExecStart=/usr/bin/node jobs/retencao.js
TimeoutStartSec=5min
MemoryMax=256M
Nice=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
