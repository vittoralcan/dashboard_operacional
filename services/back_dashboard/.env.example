# Na VM: /etc/dashboard/back-dashboard.env (dono root, chmod 600). Local: npm run dev (lê .env).

PORT=3010
# Só escuta localmente — o acesso externo passa pelo Nginx.
HOST=127.0.0.1
CORS_ORIGIN=https://app.example.com,http://127.0.0.1:5500,http://localhost:8080
# Mesma JWT_SECRET do back_auth (RA-016).
JWT_SECRET=

# db_espelho, com o papel só-leitura (ver services/etl/sql/00-db-espelho.sql)
PG_ESPELHO_HOST=localhost
PG_ESPELHO_PORT=5432
PG_ESPELHO_DATABASE=db_espelho
PG_ESPELHO_USER=usr_dashboard_leitura
PG_ESPELHO_PASSWORD=

# db_dashboard, schema painel — metas/notificações/auditoria (ops/00-db-dashboard.sql).
# Dado operacional, diferente do espelho: precisa entrar no backup da VM.
PG_PAINEL_HOST=localhost
PG_PAINEL_PORT=5432
PG_PAINEL_DATABASE=db_dashboard
PG_PAINEL_USER=usr_dashboard_app
PG_PAINEL_PASSWORD=
