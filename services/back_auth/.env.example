# Copie para services/back_auth/.env (fora do git) e preencha com os valores
# reais do ambiente. Nomes de variável devem bater 1:1 com
# services/back_auth/src/config/*.js.

# PostgreSQL de credenciais (cloud gratuito, ex: Postgres gerenciado) — banco dedicado,
# separado do Postgres operacional do painel (db_dashboard). Guarda só a tabela "usuarios".
#
# Recomendado usar a connection string "pooled" do Postgres gerenciado (host com sufixo
# "-pooler", via PgBouncer) tanto em produção quanto local — não é
# obrigatório (o processo aqui é persistente, não serverless, então a
# conexão direta também funciona sem risco de esgotar conexões), mas evita
# surpresa se o tráfego crescer.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Postgres gerenciado (e a maioria dos provedores cloud gratuitos) exige SSL — manter "true".
DB_SSL=true

# Segredo de assinatura do JWT (login) — string longa e aleatória, nunca
# reaproveitada de outro projeto. Gerar uma vez com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se algum outro back_<projeto>/ passar a validar esse token diretamente (sem
# chamar o back_auth), ele precisa da MESMA JWT_SECRET no seu próprio .env.
JWT_SECRET=

# E-mail de senha temporária (POST /auth/usuarios) — opcional: se não
# preenchido, a API cai no fallback de devolver a senha na resposta (como
# hoje), em vez de falhar a criação do usuário.
#
# Google Workspace: SMTP_USER é a caixa de TI (ex.: ti@example.com), com
# verificação em 2 etapas ATIVADA na conta. SMTP_PASSWORD não é a senha de
# login normal — é uma "senha de app" gerada em
# https://myaccount.google.com/apppasswords (16 caracteres, só pra esse uso).
# Sem isso, o Google recusa a autenticação SMTP (login/senha comuns não são
# aceitos para esse protocolo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente exibido no e-mail — recomenda-se o mesmo endereço de SMTP_USER.
SMTP_FROM="Painel Operacional <ti@example.com>"

# API
PORT=3002
# Interface de escuta. Padrão 127.0.0.1 (atrás do Nginx); 0.0.0.0 só se for expor direto.
HOST=127.0.0.1
# Lista de origens permitidas separadas por vírgula, sem espaços extras.
# NUNCA usar '*' (ver RA-010 em docs/arquitetura/regras-de-arquitetura.md) — sem CORS restrito,
# a API aceita chamadas de qualquer site feitas via navegador de terceiros.
CORS_ORIGIN=https://app.example.com,http://127.0.0.1:5500,http://127.0.0.1:5501,http://localhost:8080
