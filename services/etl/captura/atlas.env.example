# Fonte ATLAS (projeto fictício do showcase): instância própria do sistema de captura, acessada por VPN.
# Na VM: copiar para /etc/dashboard/etl-captura-atlas.env (dono root, chmod 600).
# Local: node --env-file=atlas.env app.js

ETL_FONTE=atlas
# Ids de fluxo (FLU_ID) do sistema de captura que este ETL copia, um por instância do flow-viewer:
# 4 = Negativos · 8 = Certidões (com lotes de outra tipologia estacionados na fase 109 "Aguardando")
# 9 = Inventários (idem, fase 120 "Aguardando Indexação") · 10 = Cartografia (fluxo único)
CAPTURA_FLU_IDS=4,8,9,10

# Login SQL Server só-leitura, com SELECT apenas nas 8 tabelas de tabelas.js
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=db_espelho
PG_USER=usr_etl_espelho
PG_PASSWORD=
